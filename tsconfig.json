{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "types": [
      "node"
    ],
    "paths": {
      "@omnimesh/core": [
        "./packages/core/src/index.ts"
      ],
      "@omnimesh/node": [
        "./packages/node/src/index.ts"
      ],
      "@omnimesh/router": [
        "./packages/router/src/index.ts"
      ],
      "@omnimesh/providers": [
        "./packages/providers/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*",
    "examples/**/*"
  ],
  "exclude": [
    "**/node_modules",
    "packages/providers/_template"
  ]
}