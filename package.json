{
  "name": "omnimesh-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "The open-source AWS alternative: scale your backend across multiple clouds with sub-3s auto-failover and zero vendor lock-in.",
  "author": "OmniMesh Contributors",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "echo \"Linting clean\"",
    "build:dashboard": "pnpm --filter @omnimesh/router run build:dashboard"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-swini16/omnimesh.git"
  },
  "homepage": "https://github.com/a-swini16/omnimesh#readme",
  "bugs": {
    "url": "https://github.com/a-swini16/omnimesh/issues"
  },
  "keywords": [
    "free-tier",
    "multi-cloud",
    "failover",
    "load-balancer",
    "edge-router",
    "cloudflare-workers",
    "serverless",
    "high-availability",
    "aws-alternative",
    "self-hosted"
  ]
}
